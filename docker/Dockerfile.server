FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY server/package*.json ./
RUN npm ci

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY server/ .
RUN npm run build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY server/package*.json ./
RUN mkdir -p /app/downloads
EXPOSE 3001
CMD ["node", "dist/index.js"]
