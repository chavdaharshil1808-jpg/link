# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=3001
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# ─── Python Service ───────────────────────────────────────────────────────────
PYTHON_PORT=8001
PYTHON_SERVICE_URL=http://localhost:8001

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev): file:./dev.db
# PostgreSQL (Docker): postgresql://uduser:udpassword@localhost:5432/universal_downloader
DATABASE_URL=file:./dev.db

# ─── Docker: Postgres (only used when running `docker compose up`) ────────────
# POSTGRES_USER=uduser
# POSTGRES_PASSWORD=udpassword
# POSTGRES_DB=universal_downloader
# POSTGRES_PORT=5432

# ─── Docker: Redis (only used when running `docker compose up`) ───────────────
# REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Persistent Sessions ───────────────────────────────────────────────────────
# 32-byte (64 hex chars) AES-256-GCM key used to encrypt stored provider cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=change-this-to-a-random-64-char-hex-string
SESSION_TTL_DAYS=30
SESSION_SHORT_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_MIN=60

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── SMTP (Email) ─────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# ─── yt-dlp ───────────────────────────────────────────────────────────────────
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# ─── Downloads ────────────────────────────────────────────────────────────────
DOWNLOAD_DIR=./downloads

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
